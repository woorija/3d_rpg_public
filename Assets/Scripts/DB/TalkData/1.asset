  - questId: 102
    questProgress: 0
    talkIndex: 2
    talkNpcId: 1
    talk: "\uADF8\uB7F0\uB370, \uB9C8\uC744 \uACF5\uD130\uC5D0 \uBC15\uC950\uB4E4\uC774
