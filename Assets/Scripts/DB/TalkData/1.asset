  - questId: 101
    questProgress: 2
    talkIndex: 1
    talkNpcId: 1
    talk: "\uC544\uBB34\uD2BC \uB9CC\uB098\uC11C \uBC18\uAC11\uB2E4."
  - questId: 102
    questProgress: 0
    talkIndex: 0
    talkNpcId: 1
    talk: "\uC774 \uC55E\uC5D0 \uB9C8\uC744\uC774 \uC788\uC5B4."
  - questId: 102
    questProgress: 0
    talkIndex: 1
    talkNpcId: 1
    talk: "\uC7A0\uAE50 \uC6B0\uB9AC \uB9C8\uC744\uC5D0\uC11C \uBA38\uBB34\uB294
