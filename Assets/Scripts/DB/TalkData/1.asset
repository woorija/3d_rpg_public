  - questId: 101
    questProgress: 1
    talkIndex: 2
    talkNpcId: 1
    talk: "\uB098\uB3C4 \uC774\uB7F0\uAC74 \uCC98\uC74C\uC774\uB77C \uB2F9\uD669\uC2A4\uB7FD\uAC70\uB4E0?\n\uC7A0\uAE50\uB9CC
