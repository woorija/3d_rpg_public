  - questId: 101
    questProgress: 2
    talkIndex: 0
    talkNpcId: 1
    talk: "\uAE30\uC5B5\uC744 \uC783\uC740\uAC74 \uB0B4\uAC00 \uB3C4\uC640\uC904
