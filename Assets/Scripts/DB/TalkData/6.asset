  - questId: 606
    questProgress: 0
    talkIndex: 0
    talkNpcId: 6
    talk: "\uD070\uC77C\uC77C\uC138.\n\uC5B8\uB355\uC704\uC5D0 \uC2A4\uD30C\uD06C\uAC00
      \uB098\uD0C0\uB0AC\uC5B4."
  - questId: 606
    questProgress: 0
    talkIndex: 1
    talkNpcId: 6
    talk: "\uC2A4\uD30C\uD06C\uB294 \uC6B0\uB9AC \uB9C8\uC744\uC758 \uACE8\uCE6B\uAC70\uB9AC\uC77C\uC138.\n\uB9E4
      \uB144, \uB9C8\uC744\uC0AC\uB78C\uB4E4\uC774 \uD798\uC744 \uD569\uCCD0 \uC800\uC9C0\uD588\uC9C0\uB9CC
      \uC0AC\uB78C\uB4E4\uC774 \uC5BC\uB9C8 \uC548\uB0A8\uC544\uC11C \uB354 \uC774\uC0C1
      \uB9C8\uC744\uC0AC\uB78C\uB4E4\uC758 \uD798\uB9CC\uC73C\uB85C\uB294 \uC2A4\uD30C\uD06C\uB97C
      \uBAB0\uC544\uB0BC \uC218 \uC5C6\uB2E4\uB124."
  - questId: 606
    questProgress: 0
    talkIndex: 2
    talkNpcId: 6
    talk: "\uBD80\uB514 \uC790\uB124\uAC00 \uC6B0\uB9B4 \uB3C4\uC640\uC8FC\uAE38
      \uBC14\uB77C\uB124."
  - questId: 606
    questProgress: 2
    talkIndex: 0
    talkNpcId: 6
    talk: "\uC2A4\uD30C\uD06C\uB97C \uB9C9\uC544\uC918\uC11C \uACE0\uB9D9\uB124.\n\uC790\uB124\uB294
      \uC6B0\uB9AC \uB9C8\uC744\uC758 \uC601\uC6C5\uC774\uC57C."
  - questId: 606
    questProgress: 2
    talkIndex: 1
    talkNpcId: 6
    talk: "\uC5B8\uB355\uC73C\uB85C \uAC00\uB294 \uAE38\uC758 \uBC18\uB300\uD3B8\uC73C\uB85C
      \uAC00\uBA74 XXX\uB9C8\uC744\uC774 \uC788\uB2E4\uB124.\n\uC790\uB124\uC758
      \uBAA9\uD45C\uAC00 \uADF8 \uACF3\uC5D0 \uC788\uAE38 \uBC14\uB77C\uB124."
  - questId: 606
    questProgress: 2
    talkIndex: 2
    talkNpcId: 6
    talk: "\uC6B0\uB9AC \uB9C8\uC744\uC758 \uC601\uC6C5\uC758 \uC55E\uAE38\uC5D0
      \uCD95\uBCF5\uC744."
