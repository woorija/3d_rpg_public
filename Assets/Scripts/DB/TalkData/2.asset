  talkDatas:
  - questId: 0
    questProgress: 0
    talkIndex: 0
    talkNpcId: 2
    talk: "\uB9CC\uB098\uC11C \uBC18\uAC00\uC6CC!\n\uB098\uB294 \uD55C\uC2A4\uC57C."
  - questId: 0
    questProgress: 0
    talkIndex: 1
    talkNpcId: 2
    talk: "\uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uC628\uAC78 \uD658\uC601\uD574."
  - questId: 102
    questProgress: 2
    talkIndex: 0
    talkNpcId: 2
    talk: "\uC798 \uC7A1\uB294\uB370? \uBC15\uC950\uC0AC\uB0E5\uC5D0 \uC7AC\uB2A5\uC774
      \uC788\uC5B4."
  - questId: 102
    questProgress: 2
    talkIndex: 1
    talkNpcId: 2
    talk: "\uC55E\uC73C\uB85C\uB3C4 \uC798 \uBD80\uD0C1\uD55C\uB2E4."
  - questId: 201
    questProgress: 0
    talkIndex: 0
    talkNpcId: 2
    talk: "\uB9C8\uC744\uC5D0 \uC628 \uAE40\uC5D0 \uB9C8\uC744\uC0AC\uB78C\uB4E4\uC5D0\uAC8C
      \uC778\uC0AC\uB098 \uD558\uACE0 \uC640"
  - questId: 201
    questProgress: 0
    talkIndex: 1
    talkNpcId: 2
    talk: "\uC120\uBB3C \uC900\uBE44\uD574\uB458\uD14C\uB2C8\uAE4C \uC778\uC0AC \uB3CC\uB9AC\uACE0
      \uB2E4\uC2DC \uB098\uD55C\uD14C \uC640"
  - questId: 201
    questProgress: 2
    talkIndex: 0
    talkNpcId: 2
    talk: "\uBAA8\uB450\uC5D0\uAC8C \uC778\uC0AC \uB3CC\uB9AC\uACE0 \uC654\uC5B4?"
  - questId: 201
    questProgress: 2
    talkIndex: 1
    talkNpcId: 2
    talk: "\uC790, \uC5EC\uAE30 \uC120\uBB3C\uC774\uC57C."
  - questId: 202
    questProgress: 0
    talkIndex: 0
    talkNpcId: 2
    talk: "\uD070\uC77C\uC774\uC57C.\n\uBC15\uC950\uB791 \uBC84\uC12F\uC774 \uB108\uBB34
      \uB9CE\uC544\uC9C0\uACE0\uC788\uC5B4."
  - questId: 202
    questProgress: 0
    talkIndex: 1
    talkNpcId: 2
    talk: "\uB9C8\uC744\uC0AC\uB78C\uB4E4 \uB3C4\uC640\uC11C \uB108\uB3C4 \uBC15\uC950\uB791
      \uBC84\uC12F\uC880 \uC7A1\uC544\uC918."
  - questId: 202
    questProgress: 2
    talkIndex: 0
    talkNpcId: 2
    talk: "\uC624, \uB9CE\uC774 \uD65C\uC57D\uD588\uB354\uAD70."
  - questId: 202
    questProgress: 2
    talkIndex: 1
    talkNpcId: 2
    talk: "\uBCF4\uC0C1\uC744 \uC900\uBE44\uD588\uC73C\uB2C8 \uBC1B\uC544\uAC00."
  - questId: 203
    questProgress: 0
    talkIndex: 0
    talkNpcId: 2
    talk: "\uB9CE\uC774 \uAC15\uD574\uC84C\uB124."
  - questId: 203
    questProgress: 0
    talkIndex: 1
    talkNpcId: 2
    talk: "\uB354 \uAC15\uD574\uC9C0\uB294 \uBC29\uBC95\uC774 \uC788\uC5B4.\n\uD55C\uBC88
      \uB4E4\uC5B4\uBCFC\uB798?"
  - questId: 203
    questProgress: 1
    talkIndex: 0
    talkNpcId: 2
    talk: "\uC77C\uC815 \uC218\uC900 \uC774\uC0C1 \uAC15\uD574\uC9C4 \uC874\uC7AC\uB294
      \uC5B4\uB5A4 \uBC29\uBC95\uC744 \uD1B5\uD574 \uB354 \uAC15\uD574\uC9C8 \uC218
      \uC788\uB2E4\uACE0 \uD574."
  - questId: 203
    questProgress: 1
    talkIndex: 1
    talkNpcId: 2
    talk: "\uADF8\uB9AC\uACE0 \uC6B0\uB9B0 \uADF8\uAC78 \uC804\uC9C1\uC774\uB77C\uACE0
      \uBD80\uB974\uC9C0."
  - questId: 203
    questProgress: 1
    talkIndex: 2
    talkNpcId: 2
    talk: "\uB108\uB77C\uBA74 \uC544\uB9C8 \uC804\uC9C1\uC774 \uAC00\uB2A5\uD560\uAC70\uC57C."
  - questId: 203
    questProgress: 2
    talkIndex: 0
    talkNpcId: 2
    talk: "\uC804\uC9C1\uC740 \uC5B4\uB5BB\uAC8C \uD558\uB0D0\uACE0?"
  - questId: 203
    questProgress: 2
    talkIndex: 1
    talkNpcId: 2
    talk: "\uC774\uC7A5\uB2D8\uC744 \uCC3E\uC544\uAC00\uBD10."
  - questId: 203
    questProgress: 2
    talkIndex: 2
    talkNpcId: 2
    talk: "\uADF8 \uBD84\uC774 \uC6B0\uB9AC \uB9C8\uC744\uC5D0\uC11C \uC720\uC77C\uD558\uAC8C
      \uC804\uC9C1\uC744 \uD574\uBCF8 \uBD84\uC774\uC57C."
